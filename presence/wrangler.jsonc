{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cadams-presence",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "presence.cadams.io",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CURSOR_ROOMS",
        "class_name": "CursorRoom"
      }
    ]
  },
  "exports": {
    "CursorRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  }
}
